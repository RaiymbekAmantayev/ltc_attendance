# --- ltc-cabinet-node (Node.js кабинет, деплой из GitHub Actions ltc_attendance) — НЕ УДАЛЯТЬ ---
# Отдельный блок в конце /home/ductor-ops/caddy/Caddyfile. Блок ltc.main.yelumio.kz не трогаем.
# DNS: attendance.ltsastana.kz A 45.93.136.191 (зона на ps.kz).
# Проверка и применение:
#   sudo -u ductor-ops /home/ductor-ops/.local/bin/caddy validate --config /home/ductor-ops/caddy/Caddyfile --adapter caddyfile
#   systemctl reload ltc-caddy
attendance.ltsastana.kz {
    reverse_proxy 127.0.0.1:9120
}
